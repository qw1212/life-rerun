# 服务端配置
PORT=3001
NODE_ENV=development

# AI 模型 API 配置（任选其一）
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

