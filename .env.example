# AI provider 配置（OpenAI 兼容接口）
# 未配置或仍为占位值时，服务会自动使用内置事件库叙事，游戏依然可玩
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 服务端口号
PORT=3001

# 允许跨域访问的来源，逗号分隔；留空表示不限制（本地开发默认）
# 生产环境示例：ALLOWED_ORIGINS=https://life-rerun.com,https://www.life-rerun.com
ALLOWED_ORIGINS=

# 单个 IP 每分钟最多请求叙事接口的次数（防止 API Key 被刷）
RATE_LIMIT_PER_MINUTE=30

# 信任的代理层数。Nginx 反向代理部署保持 1；后端直接暴露公网时设为 0
TRUST_PROXY=1
